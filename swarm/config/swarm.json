    "types": [
      "md.*",
      "ref.*",
      "uni.list",
      "guard.status",
      "sys.log",
      "sys.dead",
      "feat.bar",
      "regime.state",
      "idea",
      "shadow.*",
      "event.window",
      "sys.heartbeat"
    ],
    "flushMs": 1000,
    "compressAfterMin": 10,
    "keepDays": 60
  },
  "brain": {
    "warmup": true,
    "warmupDays": 7,
    "batchWaitMs": 6000
  },
  "events": {
    "url": "https://nfs.faireconomy.media/ff_calendar_thisweek.json",
    "countries": [
      "USD"
    ],
    "impact": [
      "High"
    ],
    "beforeMin": 5,
    "afterMin": 10,
    "refreshMin": 60,
    "manual": []
  },
